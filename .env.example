# EmprendeLink DWF - Local environment example
# Copy these values to the local configuration mechanism used by the project.
# Never place real passwords or secrets in this file.

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=emprendelink_dwf
DB_USER=tu_usuario
DB_PASSWORD=tu_password

# JDBC
DB_URL=jdbc:mysql://localhost:3306/emprendelink_dwf

# Application
APP_CONTEXT_PATH=/emprendelink